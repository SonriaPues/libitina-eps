# =====================================================================
# Copia este archivo como .env y CAMBIA todas las claves antes de desplegar.
# El archivo .env nunca se sube a GitHub (está en .gitignore).
# =====================================================================

# ---------- Superusuario de PostgreSQL (solo se usa al crear las bases) ----------
POSTGRES_SUPERUSUARIO=libitina_admin
POSTGRES_SUPERCLAVE=cambia-superclave-general
POSTGRES_SUPERCLAVE_CLINICA=cambia-superclave-clinica

# ---------- Un usuario de base de datos por servicio ----------
SVC_AUTH_PASSWORD=cambia-auth
SVC_AFILIADOS_PASSWORD=cambia-afiliados
SVC_PRESTADORES_PASSWORD=cambia-prestadores
SVC_NOTIFICACIONES_PASSWORD=cambia-notificaciones
SVC_TRAMITES_PASSWORD=cambia-tramites
SVC_CITAS_PASSWORD=cambia-citas
SVC_HISTORIA_PASSWORD=cambia-historia

# ---------- Seguridad de la API ----------
# Genera valores largos y aleatorios, por ejemplo con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-clave-jwt-larga-y-aleatoria
INTERNAL_TOKEN=cambia-este-token-interno
JWT_MINUTOS=30
REFRESH_DIAS=7
# Clave para cifrar los textos de la historia clínica (pgcrypto). Si se pierde, esos datos no se recuperan.
CLAVE_CIFRADO_HISTORIA=cambia-esta-clave-de-cifrado

# ---------- Administrador inicial ----------
ADMIN_CORREO=admin@libitina.co
ADMIN_CLAVE=Admin123
ADMIN_DOCUMENTO=1000000000

# ---------- Dirección pública ----------
# Desarrollo: el front de Vite. Producción: https://<tu DOMINIO> (se usa en CORS y en los enlaces de los correos)
FRONTEND_URL=http://localhost:5173

# ---------- Solo producción (Azure) ----------
# Nombre DNS que Azure da a la máquina, ej. libitina-eps.eastus.cloudapp.azure.com
DOMINIO=
# Correo al que Let's Encrypt avisa si el certificado HTTPS va a vencer
CORREO_CERTIFICADO=
# Hora (UTC) desde la que se hace el respaldo diario. 02 UTC = 9:00 p. m. en Colombia (antes del apagado automático)
HORA_RESPALDO=02

# ---------- Correo ----------
# Desarrollo: Mailpit atrapa todos los correos -> bandeja en http://localhost:8025
# Producción: OBLIGATORIO usar el bloque de Gmail (Azure bloquea el puerto 25, pero no el 587)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_TLS=false
CORREO_REMITENTE=Libitina EPS <no-responder@libitina.co>

# Demostración con Gmail (usa una "contraseña de aplicación", nunca tu clave normal):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USUARIO=tucorreo@gmail.com
# SMTP_CLAVE=xxxx xxxx xxxx xxxx
# SMTP_TLS=true
# CORREO_REMITENTE=Libitina EPS <tucorreo@gmail.com>
