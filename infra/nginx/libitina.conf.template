# Proxy inverso con HTTPS (Let's Encrypt). La imagen oficial de Nginx reemplaza
# ${DOMINIO} al arrancar; las variables propias de Nginx ($host...) no se tocan.

limit_req_zone $binary_remote_addr zone=por_ip:10m rate=20r/s;

server {
  listen 80;
  server_name ${DOMINIO};

  # Validación de Let's Encrypt
  location /.well-known/acme-challenge/ { root /var/www/certbot; }

  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMINIO};

  ssl_certificate     /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;

  add_header Strict-Transport-Security "max-age=31536000" always;
  server_tokens off;
  client_max_body_size 6m;     # adjuntos de PQRSD hasta 5 MB

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  location / {
    limit_req zone=por_ip burst=40 nodelay;
    proxy_pass http://gateway:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Se SOBRESCRIBE con la IP real: el cliente no puede falsificarla (el Gateway la usa para el límite de peticiones)
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }
}
